{
  "name": "@wsehl/pi-featherless",
  "version": "1.1.0",
  "description": "Featherless.ai provider for Pi coding agent",
  "keywords": [
    "featherless",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "author": "Alex Sehl <widesehl@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsehl/pi-featherless.git"
  },
  "files": [
    "index.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "changeset": "changeset",
    "check": "pnpm run lint && pnpm run format-check && pnpm run type-check",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepublishOnly": "pnpm run check",
    "release": "changeset publish",
    "type-check": "tsc --noEmit",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "packageManager": "pnpm@11.5.1",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
